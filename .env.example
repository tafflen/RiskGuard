# Application
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
APP_NAME=RiskGuard API
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
MAX_REQUEST_BODY_BYTES=1048576

# PostgreSQL/PostGIS — provisioned in Phase 2
DATABASE_URL=postgresql+asyncpg://riskguard:change-me@localhost:5432/riskguard
# Dedicated test database only; never point this at a production database.
TEST_DATABASE_URL=postgresql+asyncpg://riskguard:change-me@localhost:5433/riskguard_test
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# Redis — provisioned in Phase 10
REDIS_URL=redis://localhost:6379/0

# Authentication — replace with a high-entropy secret in every environment
JWT_SECRET=replace-with-a-minimum-32-character-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# External integrations — optional until their respective phases
MAPBOX_ACCESS_TOKEN=
WEATHER_API_KEY=
FIREBASE_CREDENTIALS=
